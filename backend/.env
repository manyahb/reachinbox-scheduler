# --- Server ---
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- Postgres ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reachinbox

# --- Redis (used by BullMQ + rate limiter + idempotency locks) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Ethereal Email (fake SMTP) ---
# Get these by running: npm run create:ethereal  (or from https://ethereal.email)
ETHEREAL_USER=
ETHEREAL_PASS=

# --- Worker / throughput config (all configurable, no hardcoding) ---
WORKER_CONCURRENCY=5
# Minimum milliseconds between two email sends processed by a single worker slot
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Default hourly cap per sender, unless overridden per-sender in the `senders` table
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# --- Google OAuth (frontend login) ---
GOOGLE_CLIENT_ID=278405081509-sod6j08tu0rulqh5emlhbbt0c5f2tq9a.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
SESSION_SECRET=change_me_dev_secret

# --- Slack OAuth (per-tenant rate-limit notifications) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/oauth/callback

# --- Elasticsearch ---
ELASTICSEARCH_NODE=http://localhost:9200
